GEMINI_API_KEY=pega_aqui_tu_api_key
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3.x: "low" reduce la latencia (gemini-3.5-flash ~30 s; gemini-3.8-flash 60-100 s por petición).
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=180
# text-embedding-004 fue retirado de la Gemini API (14-ene-2026): usa gemini-embedding-001.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
DATABASE_URL=sqlite+aiosqlite:///./handwriting.db
